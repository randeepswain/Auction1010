# ==============================================================================
# BACKEND CONFIGURATION (RAILWAY / RENDER)
# ==============================================================================

# Server Settings
PORT=3001
NODE_ENV=production
JWT_SECRET=replace_this_with_a_long_random_string

# Allowed Frontend URL (CORS)
# Set this to your Netlify URL (e.g., https://your-site.netlify.app)
CORS_ORIGIN=https://your-frontend-site.netlify.app

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Railway will automatically provide DATABASE_URL if you add a Postgres plugin
DATABASE_URL=postgres://user:password@host:port/dbname

# ------------------------------------------------------------------------------
# CACHE & REAL-TIME (Redis)
# ------------------------------------------------------------------------------
# Railway will automatically provide REDIS_URL if you add a Redis plugin
REDIS_URL=redis://user:password@host:port
